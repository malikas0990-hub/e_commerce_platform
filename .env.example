# Production overrides for docker-compose (copy to .env on the server).
# docker compose automatically loads .env from the project root.

# Strong random secret for signing JWTs (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-this-in-production-please

# Public origin of the frontend, used for CORS / Socket.IO
FRONTEND_URL=http://localhost:3000

# Host port the frontend (nginx) is published on. Use 80 in production.
FRONTEND_PORT=3000

# Run the database seed on backend start when the DB is empty
SEED_ON_START=true
