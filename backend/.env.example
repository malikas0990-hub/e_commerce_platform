# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
SEED_ON_START=true

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clothing_shop
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth
JWT_SECRET=change-this-to-a-long-random-string

# Logging
LOG_LEVEL=info
